# Copy this file to .env and fill in your own values.
# Never commit the real .env file — add it to .gitignore.

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# --- Azure ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# --- Google Cloud ---
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Docker / Container Registry ---
DOCKER_USERNAME=
DOCKER_PASSWORD=

# --- Database ---
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# --- Security / Scanning Tools ---
SNYK_TOKEN=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# --- General App Secrets ---
SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
